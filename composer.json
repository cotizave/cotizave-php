{
    "name": "cotizave/sdk",
    "description": "Official PHP SDK for the Cotizave API v2 — multi-country exchange-rate references, conversions, history, banks and calendars.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/cotizave/cotizave-php",
    "keywords": [
        "cotizave",
        "exchange-rate-api",
        "currency-api",
        "forex-api",
        "exchange-rates",
        "currency-conversion",
        "sdk"
    ],
    "authors": [
        {
            "name": "Cotizave"
        }
    ],
    "support": {
        "issues": "https://github.com/cotizave/cotizave-php/issues",
        "docs": "https://docs.cotizave.com"
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Cotizave\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cotizave\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "test": "phpunit",
        "gate": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
